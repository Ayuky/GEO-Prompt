# ============================================================
# GEO Platform — Docker Compose 统一环境变量
# ============================================================
# 复制此文件为 .env 并修改下方的值

# -------- MySQL (core) --------
MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_DATABASE=ry-vue
MYSQL_PORT=3306

# -------- Redis (shared: core + langfuse) --------
REDIS_PORT=6379

# -------- RuoYi Backend --------
RUOYI_BACKEND_PORT=8080

# -------- RuoYi Frontend --------
RUOYI_FRONTEND_PORT=80

# -------- GeoPrompt --------
GEOPROMPT_PORT=8000
ENCRYPTION_KEY=CHANGEME

# -------- Langfuse --------
LANGFUSE_WEB_PORT=3000
LANGFUSE_POSTGRES_PORT=5432
LANGFUSE_CLICKHOUSE_HTTP_PORT=8123
LANGFUSE_CLICKHOUSE_NATIVE_PORT=9000
LANGFUSE_MINIO_API_PORT=9090
LANGFUSE_MINIO_CONSOLE_PORT=9091
# Langfuse credentials
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME

# Langfuse internal secrets (CHANGEME for production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME
REDIS_AUTH=
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY_LANGFUSE=CHANGEME
